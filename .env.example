# === Développement local ===

# Base SQLite (chemin relatif à prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Secret de signature des cookies de session — générez-le avec: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"

# URL de base de l'app, utilisée pour construire les liens d'invitation
APP_URL="http://localhost:3000"

# Envoi d'email d'invitation (SMTP). Optionnel : si non configuré, le lien
# d'activation reste affiché à l'admin (mode manuel).
# Exemple Gmail (nécessite un « mot de passe d'application ») :
#   SMTP_HOST="smtp.gmail.com"
#   SMTP_PORT="465"
#   SMTP_SECURE="true"
#   SMTP_USER="votre.email@gmail.com"
#   SMTP_PASS="xxxx xxxx xxxx xxxx"   # mot de passe d'application Google
#   MAIL_FROM="ApportAffaires <votre.email@gmail.com>"


# === Production (Railway) — à définir dans les variables du service ===
#
# DATABASE_URL="file:/data/prod.db"   # /data = point de montage du volume persistant
# AUTH_SECRET="<openssl rand -base64 32>"
# APP_URL="https://<votre-app>.up.railway.app"
# ADMIN_EMAIL="hadid.coding@gmail.com" # crée le compte admin au 1er démarrage
# ADMIN_PASSWORD="<mot de passe fort>"
# ADMIN_NAME="Admin"
